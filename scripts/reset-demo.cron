# Nightly demo reset at 03:30 JST (18:30 UTC). Install with:
#   sudo cp scripts/reset-demo.cron /etc/cron.d/ownstack-demo-reset
# Adjust the path to the portal checkout and the user that owns the Docker socket.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
30 18 * * * ubuntu /opt/ownstack/portal/scripts/products.sh reset >> /var/log/ownstack-demo-reset.log 2>&1
