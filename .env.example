# ---- Public addresses --------------------------------------------------------
# The portal is served at https://www.<PUBLIC_DOMAIN>; demos at <name>.<DEMO_ZONE>.
# Local development: PUBLIC_DOMAIN=localhost gives http://www.localhost,
# http://devflow.demo.localhost etc. (browsers resolve *.localhost to 127.0.0.1).
PUBLIC_DOMAIN=localhost
DEMO_ZONE=demo.localhost
# "" = automatic HTTPS via Let's Encrypt; "http://" = plain HTTP (local only)
SITE_ADDRESS_PREFIX=http://
DEMO_SCHEME=http
ACME_EMAIL=
# Leave empty to derive ".<PUBLIC_DOMAIN>" automatically; set when DEMO_ZONE is elsewhere.
DEMO_COOKIE_DOMAIN=

# Host ports for the gateway (80/443 in production)
HTTP_PORT=80
HTTPS_PORT=443

# ---- Demo sessions -----------------------------------------------------------
# openssl rand -hex 32
DEMO_SESSION_SECRET=
DEMO_SESSION_MINUTES=45
DEMO_MAX_CONCURRENT=5
# Ask visitors for name/email/company before a session starts
DEMO_REQUIRE_EMAIL=false
# Shown on the DevFlow launch page once a session is active (created by scripts/products.sh)
DEVFLOW_DEMO_PASSWORD=

# ---- Where the products run --------------------------------------------------
# Defaults assume each product's own compose is running on this host.
DEVFLOW_UPSTREAM=http://host.docker.internal:8000
AGENTCANVAS_UPSTREAM=http://host.docker.internal:7777
MATURA_UPSTREAM=http://host.docker.internal:8080
KEYCLOAK_UPSTREAM=http://host.docker.internal:8180

# ---- Support form ------------------------------------------------------------
# Optional: POST each ticket as JSON to this URL (Slack incoming webhook, n8n, helpdesk).
# Tickets are always written to /data/tickets.jsonl inside the portal container.
SUPPORT_WEBHOOK_URL=

# ---- Image ---------------------------------------------------------------------
PORTAL_IMAGE=ownstack/portal:local
